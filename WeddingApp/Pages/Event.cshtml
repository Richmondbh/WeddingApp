@page
@model EventModel
@{
    ViewData["Title"] = "Event";
}

<h1 class="event-title text-center">@Model.EventInfo.Title</h1>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="card-title h4">Event details</h2>

                <p><strong>Date:</strong> @Model.EventInfo.Date</p>
                <p><strong>Time:</strong> @Model.EventInfo.Time</p>
                <p><strong>Location:</strong> @Model.EventInfo.Location</p>
                <p>@Model.EventInfo.Description</p>

                <p>
                    Responses received so far:
                    <span class="badge bg-success">@Model.NumOfResponses</span>
                </p>

                <a asp-page="/Rsvp" class="btn btn-primary">Respond to the invitation</a>
            </div>
        </div>

        <h2 class="h4">Notices and Updates</h2>

        <ul class="list-group mb-4">
            @foreach (Notice notice in Model.Notices)
            {
                <li class="list-group-item">
                    <strong>@notice.Heading</strong>
                    <span class="text-muted">— @notice.PublishedOn</span>
                    <p class="mb-0">@notice.Text</p>
                </li>
            }
        </ul>
    </div>
</div>
