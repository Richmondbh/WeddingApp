@*
    Shared layout used by every page: the header with the navigation menu,
    the main content area, and the footer.
*@

@{
    string currentPage = ViewContext.RouteData.Values["page"] as string;

    bool IsActive(string pagePath)
    {
        if (string.IsNullOrEmpty(currentPage))
        {
            return false;
        }

        // The second test keeps "Guests" highlighted while editing a guest.
        return currentPage == pagePath
            || currentPage.StartsWith(pagePath + "/");
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &ndash; Richmond &amp; Keziah (FLOR27)</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="site-mark" asp-page="/Index">Richmond &amp; Keziah (FLOR27) </a>

            <nav aria-label="Main menu">
                <ul class="site-nav">
                    <li>
                        <a asp-page="/Index" class="@(IsActive("/Index") ? "active" : null)"
                           aria-current="@(IsActive("/Index") ? "page" : null)">Home</a>
                    </li>
                    <li>
                        <a asp-page="/Event" class="@(IsActive("/Event") ? "active" : null)"
                           aria-current="@(IsActive("/Event") ? "page" : null)">Event</a>
                    </li>
                    <li>
                        <a asp-page="/Gallery" class="@(IsActive("/Gallery") ? "active" : null)"
                           aria-current="@(IsActive("/Gallery") ? "page" : null)">Gallery</a>
                    </li>
                    <li>
                        <a asp-page="/Rsvp" class="@(IsActive("/Rsvp") ? "active" : null)"
                           aria-current="@(IsActive("/Rsvp") ? "page" : null)">RSVP</a>
                    </li>
                    <li>
                        <a asp-page="/Guests/GuestList"
                           class="@(IsActive("/Guests") ? "active" : null)"
                           aria-current="@(IsActive("/Guests") ? "page" : null)">Guests</a>
                    </li>
                </ul>
            </nav>
        </div>
    </header>

    <main class="site-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <h2 class="footer-heading">The celebration</h2>
                    <p>
                        20 July 2027 at 17:00<br />
                        Hope Wedding Hall<br />
                        Östersund, Sweden
                    </p>
                </div>

                <div>
                    <h2 class="footer-heading">Questions</h2>
                    <p>
                        <a href="mailto:hej@@richkez.se">hej@@richkez.se</a><br />
                        +46 76 931 68 71
                    </p>
                </div>

                <div>
                    <h2 class="footer-heading">Pages</h2>
                    <ul class="footer-links">
                        <li><a asp-page="/Event">Event details</a></li>
                        <li><a asp-page="/Gallery">Photo gallery</a></li>
                        <li><a asp-page="/Rsvp">Respond to the invitation</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-base">
                <p>&copy; 2026 Richmond &amp; Keziah ((FLOR27) </p>
                <p>
                    Developed by
                    <a href="https://rhbdigital.se" target="_blank" rel="noopener">
                        RHB Digital Solutions
                    </a>
                </p>
            </div>
        </div>
    </footer>
</body>
</html>
