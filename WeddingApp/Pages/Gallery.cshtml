@page
@model GalleryModel
@{
    ViewData["Title"] = "Gallery";
}

<h1 class="event-title text-center">Photo Gallery</h1>

<p class="text-center">A few of our favourite moments on the way to the big day.</p>

<div class="row">
    @foreach (GalleryImage image in Model.Images)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="~/images/@image.FileName" class="card-img-top  gallery-image"
                     alt="@image.AltText" />
                <div class="card-body">
                    <p class="card-text text-center">@image.Caption</p>
                </div>
            </div>
        </div>
    }
</div>
